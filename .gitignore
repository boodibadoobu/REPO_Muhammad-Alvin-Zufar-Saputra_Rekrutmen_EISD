/.phpunit.cache
/coverage/
/storage/pail
__pycache__/
*.pyc

# Local editor, agent, VM, and deployment-tool settings.
/.agents/
/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed
/.vercel/
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Presentation scripts, diagram working files, and personal study documents.

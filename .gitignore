# Local environment and credentials; keep the setup example versioned.
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# Installed dependencies and generated frontend output.
/node_modules
/vendor
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage

# Test output, logs, and local caches.
*.log
